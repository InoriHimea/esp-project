# ── Platform Backend (API Gateway) ──────────────────────────────────────────
# Used for platform mode: login, device management, multi-device dashboard

# REST API base URL (without trailing slash)
VITE_SERVER_API=http://localhost:8080/api/v1

# WebSocket URL
VITE_SERVER_WS=ws://localhost:8080/ws

# ── ESP32 Direct Connection ──────────────────────────────────────────────────
# Used only for debug/local mode: direct connection to a single ESP32 device
# (Not used when working through the platform backend)

# REST base URL  (without trailing slash)
VITE_ESP32_API=http://192.168.1.100/api

# WebSocket URL
VITE_ESP32_WS=ws://192.168.1.100/ws

# ── Dev proxy ────────────────────────────────────────────────────────────────
# When running `pnpm dev`, the Vite proxy in vite.config.ts forwards
# /api  → http://${ESP32_HOST}/api
# /ws   → ws://${ESP32_HOST}/ws
# Set the target here:
ESP32_HOST=http://192.168.1.100
ESP32_WS=ws://192.168.1.100
