# JWT 密鑰（請在生產環境中更改）
JWT_SECRET=your-secret-key-change-in-production

# 內部服務令牌（請在生產環境中更改）
INTERNAL_TOKEN=internal-secret-token

# CORS 允許的來源
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 管理員帳號
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# 資料庫連接（Docker Compose 會自動設置）
# DATABASE_URL=postgresql://esp_user:esp_password@localhost:5432/esp_platform?sslmode=disable

# MQTT Broker 地址（Docker Compose 會自動設置）
# MQTT_BROKER=tcp://localhost:1883
