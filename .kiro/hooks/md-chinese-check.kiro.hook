{
  "enabled": true,
  "name": "MD 文檔使用中文",
  "description": "當 Markdown 文檔被儲存時，檢查並確保內容使用中文撰寫",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "剛剛有一個 Markdown 文檔被儲存。請檢查該文檔的內容，如果其中有非中文的段落（代碼塊、URL、專有名詞除外），請將其翻譯或改寫為繁體中文，並儲存更新後的文件。"
  }
}